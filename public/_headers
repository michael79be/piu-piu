/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/config.json
  Cache-Control: no-cache, no-store, must-revalidate

/assets/*
  Cache-Control: max-age=31536000, immutable

/*.js
  Cache-Control: max-age=3600, must-revalidate

/*.css
  Cache-Control: max-age=3600, must-revalidate

/*
  X-Content-Type-Options: nosniff
